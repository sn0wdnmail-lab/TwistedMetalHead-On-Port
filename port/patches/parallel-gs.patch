+Vulkan::ImageHandle GSRenderer::create_replacement_image(uint32_t width, uint32_t height,
+                                                         const std::vector<std::vector<uint32_t>> &levels)
+{
+	if (!device || levels.empty() || !width || !height)
+		return {};
+	auto info = Vulkan::ImageCreateInfo::immutable_2d_image(width, height, VK_FORMAT_R8G8B8A8_UNORM);
+	info.levels = uint32_t(levels.size());
+	std::vector<Vulkan::ImageInitialData> initial(levels.size());
+	for (size_t i = 0; i < levels.size(); i++)
+	{
+		uint32_t w = std::max<uint32_t>(1u, width >> i), h = std::max<uint32_t>(1u, height >> i);
+		if (levels[i].size() < size_t(w) * h)
+			return {};
+		initial[i].data = levels[i].data();
+	}
+	auto img = device->create_image(info, initial.data());
+	if (img)
+		device->set_name(*img, "Replacement texture");
+	return img;
