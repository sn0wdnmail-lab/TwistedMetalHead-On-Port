+bool GSInterface::set_texture_replacement(const TextureReplacement &replacement)
+{
+	texture_replacement = {};
+	if (replacement.levels.empty() || !replacement.width || !replacement.height || replacement.tw > 10 || replacement.th > 10)
+		return false;
+	uint32_t gs_width = 1u << replacement.tw;
+	if (replacement.width < gs_width || replacement.width % gs_width != 0)
+		return false;
+	auto image = renderer.create_replacement_image(replacement.width, replacement.height, replacement.levels);
+	if (!image)
+		return false;
+	texture_replacement.tbp0 = replacement.tbp0;
+	texture_replacement.tbw = replacement.tbw;
+	texture_replacement.psm = replacement.psm;
+	texture_replacement.tw = replacement.tw;
+	texture_replacement.th = replacement.th;
+	texture_replacement.cbp = replacement.cbp;
+	// The shader keeps the mip level in 3 bits (0-7).
+	texture_replacement.levels = std::min<uint32_t>(uint32_t(replacement.levels.size()), 1u << TEX_MAX_MIP_LEVEL_BITS);
+	texture_replacement.scale = float(replacement.width) / float(gs_width);
+	texture_replacement.image = std::move(image);
+	return true;
+}
