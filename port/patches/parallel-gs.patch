+// The replacement image has a mip chain; the GS texture usually has none (fixed LOD 0), so each
+// primitive gets a fixed LOD here: the level where about one or two replacement texels land on
+// each output pixel (bilinear within the level).
+void GSInterface::apply_replacement_lod(PrimitiveAttribute &prim_attr, const VertexPosition *pos,
+                                        const VertexAttribute *attr, uint32_t count, const TextureInfo &info,
+                                        bool per_sample) const
+{
+	const auto &prim = registers.prim;
+	const auto &ctx = registers.ctx[prim.desc.CTXT];
+	float tex_w = float(1u << std::min<uint32_t>(ctx.tex0.desc.TW, 10u));
+	float tex_h = float(1u << std::min<uint32_t>(ctx.tex0.desc.TH, 10u));
+	float u_lo = 1e30f, u_hi = -1e30f, v_lo = 1e30f, v_hi = -1e30f;
+	float x_lo = 1e30f, x_hi = -1e30f, y_lo = 1e30f, y_hi = -1e30f;
+	uint32_t n = std::max<uint32_t>(2u, std::min<uint32_t>(count, 3u));
+	for (uint32_t i = 0; i < n; i++)
+	{
+		float u, v;
+		if (prim.desc.FST)
+		{
+			u = float(attr[i].uv.x) * (1.0f / 16.0f);
+			v = float(attr[i].uv.y) * (1.0f / 16.0f);
+		}
+		else
+		{
+			float q = attr[i].q != 0.0f ? attr[i].q : 1.0f;
+			u = attr[i].st.x / q * tex_w;
+			v = attr[i].st.y / q * tex_h;
+		}
+		float x = float(pos[i].pos.x) * (1.0f / float(1 << PGS_SUBPIXEL_BITS));
+		float y = float(pos[i].pos.y) * (1.0f / float(1 << PGS_SUBPIXEL_BITS));
+		u_lo = std::min(u_lo, u); u_hi = std::max(u_hi, u);
+		v_lo = std::min(v_lo, v); v_hi = std::max(v_hi, v);
+		x_lo = std::min(x_lo, x); x_hi = std::max(x_hi, x);
+		y_lo = std::min(y_lo, y); y_hi = std::max(y_hi, y);
+	}
+	// Screen size in shaded samples: the LOD is the mip whose texels are about one sample apart.
+	float dx = (x_hi - x_lo) * float(1u << (per_sample ? sampling_rate_x_log2 : 0u));
+	float dy = (y_hi - y_lo) * float(1u << (per_sample ? sampling_rate_y_log2 : 0u));
+	float ratio = 0.0f;
+	if (dx > 0.0f)
+		ratio = std::max(ratio, (u_hi - u_lo) * info.replacement_scale / dx);
+	if (dy > 0.0f)
+		ratio = std::max(ratio, (v_hi - v_lo) * info.replacement_scale / dy);
+	uint32_t lod = 0;
+	while (lod + 1 < info.replacement_levels && ratio >= 2.0f)
+	{
+		ratio *= 0.5f;
+		lod++;
+	}
+	uint32_t max_level = info.replacement_levels - 1;
+	prim_attr.tex &= ~(((1u << TEX_MAX_MIP_LEVEL_BITS) - 1u) << TEX_MAX_MIP_LEVEL_OFFSET);
+	prim_attr.tex &= ~uint32_t(TEX_SAMPLER_MIPMAP_LINEAR_BIT);
+	prim_attr.tex |= (max_level << TEX_MAX_MIP_LEVEL_OFFSET) | TEX_SAMPLER_MIN_LINEAR_BIT;
+	prim_attr.tex2 &= ~(((1u << TEX2_K_BITS) - 1u) << TEX2_K_OFFSET);
+	prim_attr.tex2 &= ~(((1u << TEX2_L_BITS) - 1u) << TEX2_L_OFFSET);
+	prim_attr.tex2 |= (1u << TEX2_FIXED_LOD_OFFSET) | ((lod << 4) << TEX2_K_OFFSET);
+	g_flush_counters[FlushCounterReplacedDraws].fetch_add(1, std::memory_order_relaxed);
+}
