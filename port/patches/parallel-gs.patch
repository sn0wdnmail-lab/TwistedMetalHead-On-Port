+	FlushCounterPressurePrimitives,
+	FlushCounterPressurePasses,
+	FlushCounterPressureImages,
+	FlushCounterPressureOther,
+	FlushCounterPrimitives,      // primitives handed to the GPU by flush_submit
+	FlushCounterReasonBase,      // + FlushReason: render-pass flushes by reason (7 reasons)
+	FlushCounterCount = FlushCounterReasonBase + 7
+};
+extern std::atomic<uint64_t> g_flush_counters[FlushCounterCount];
+// Copies the counters since the last call into out[0 .. count) and clears them.
+void take_flush_counters(uint64_t *out, size_t count);
+// Work queued before paraLLEl-GS hands it to the GPU on its own (default 4096 primitives).
+void set_minimum_primitives_for_flush(uint32_t count);
